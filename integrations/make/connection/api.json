{
  "url": "https://app.arrowsterr.com/api/v1/me",
  "method": "GET",
  "headers": {
    "X-API-Key": "{{parameters.apiKey}}"
  },
  "response": {
    "metadata": {
      "type": "text",
      "value": "{{body.workspace.name}}"
    },
    "error": {
      "message": "[{{statusCode}}] {{ifempty(body.error; 'Arrowsterr returned an error')}}"
    }
  },
  "log": {
    "sanitize": [
      "request.headers.x-api-key"
    ]
  }
}
