# Postgres. Any Postgres 15+ works (Supabase, Render, Neon). Add ?sslmode=require for hosted databases.
DATABASE_URL=postgres://localhost:5432/riselocale
# Set to "no-verify" when the host uses a certificate Node does not trust (Supabase pooler).
PGSSL=

# Rank data. "dataforseo" needs DFS_LOGIN and DFS_PASSWORD. "demo" makes up ranks for trying the app and shows a Demo data banner.
RL_DATA=dataforseo
DFS_LOGIN=
DFS_PASSWORD=
# Point at https://sandbox.dataforseo.com/v3 to test the calls for free.
DFS_API_URL=https://api.dataforseo.com/v3

# The public address, used in report links and emails.
APP_URL=http://localhost:3100

# Map tiles. Defaults to OpenStreetMap, which is fine for testing only. Use a paid tile host in production.
NEXT_PUBLIC_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Email for alerts and scheduled reports (optional). Without it alerts show in the app only.
RESEND_API_KEY=
EMAIL_FROM=RiseLocale <hello@riselocale.com>

# Free 5x5 scan limits.
FREE_SCANS_PER_IP=2
FREE_SCANS_PER_DAY=100

# The background worker runs inside the web server. Set to "off" on extra web instances if you run a separate worker.
RL_WORKER=on
# Credits a new workspace gets each month (1 pin = 1 credit).
RL_MONTHLY_CREDITS=10000
# How often the worker runs, in milliseconds.
RL_TICK_MS=5000
