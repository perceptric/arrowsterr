# Settings the app reads. docs/fly.md lists every one by group. Real values live only on the server, never here.

# Composio, for Apps for Zippie and for partner connect links (Cloudflare for AI crawler data).
# From the Composio dashboard → Settings → API keys.
COMPOSIO_API_KEY=

# Partner connect links (docs/API.md, "Partner API" → "Connect an app"): the hosts a partner's return_url may
# point at, comma-separated, exact hosts only (like chat.morningtelos.com). We set it when we add a partner.
# Empty means no partner can start a connect link.
PARTNER_RETURN_HOSTS=
